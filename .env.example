# Copy to .env.local (never commit .env.local)
# --- web app (public, safe in browser; protected by RLS) ---
VITE_SUPABASE_URL=https://<staging-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=local            # local | staging | prod (Vercel sets staging for Preview, prod for Production)
VITE_PUBLIC_BASE_URL=https://gedara.vercel.app

# --- local tooling only: e2e + SQL tests, STAGING ONLY (NEVER in apps/web). SQL tests use `supabase login` + link ---
E2E_STAGING_REF=<staging-ref> # scripts refuse to run unless the URLs above point at this ref
E2E_EMAIL=ayeshmantha@gmail.com

# --- scripts / Edge Function secrets (NEVER in apps/web) ---
SUPABASE_SERVICE_ROLE_KEY=    # staging key; used by e2e to mint login codes
GROCY_BASE_URL=
GROCY_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
ANTHROPIC_API_KEY=            # Phase 7 only, optional
